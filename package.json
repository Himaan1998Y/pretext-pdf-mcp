  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "pdf",
    "pdf-generation",
    "pdf-generator",
    "json-to-pdf",
    "invoice-pdf",
    "report-pdf",
    "ai-pdf",
    "ai-agent",
    "claude",
    "cursor",
    "windsurf",
    "typescript",
    "serverless-pdf",
    "no-chromium",
    "invoice",
    "report",
    "resume"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pretext-pdf-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pretext-pdf": "^1.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/node": "^22.0.0",
    "marked": "^18.0.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "^0.1.57",
    "bwip-js": "^4.0.0",
    "highlight.js": "^11.0.0",
    "marked": ">=9.0.0",
    "qrcode": "^1.5.0",
    "vega": "^5.0.0 || ^6.0.0",
    "vega-lite": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    },
    "bwip-js": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    },
    "marked": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    },
    "vega": {
      "optional": true
    },
    "vega-lite": {
      "optional": true
    }
  },
